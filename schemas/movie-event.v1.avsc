{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "cinema.events",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "user_id", "type": "string"},
    {"name": "movie_id", "type": "string"},
    {"name": "event_type", "type": {
      "name": "EventType",
      "type": "enum",
      "symbols": ["VIEW_STARTED", "VIEW_FINISHED", "VIEW_PAUSED", "VIEW_RESUMED", "LIKED", "SEARCHED"]
    }},
    {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "device_type", "type": {
      "name": "DeviceType",
      "type": "enum",
      "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"]
    }},
    {"name": "session_id", "type": "string"},
    {"name": "progress_seconds", "type": ["null", "int"], "default": null}
  ]
}
